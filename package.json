{
  "name": "shopistan",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "db:setup": "pnpm --filter @shopistan/api db:setup",
    "db:seed": "pnpm --filter @shopistan/api db:seed",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @shopistan/api test",
    "typecheck": "pnpm -r typecheck"
  }
}

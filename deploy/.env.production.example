# Copy to deploy/.env.production and fill in every value.

# Your platform domain. Point these DNS records at the server's IP:
#   A  shopistan.pk        A  *.shopistan.pk
DOMAIN=shopistan.pk
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=you@example.com

# Database passwords: generate each with  openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
PLATFORM_DB_PASSWORD=

# Encrypts merchants' WhatsApp credentials. Generate with  openssl rand -hex 32
# Back it up: without it, saved credentials cannot be read.
ENCRYPTION_KEY=

# First Super Admin, created on the first start.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

WHATSAPP_GRAPH_VERSION=v23.0

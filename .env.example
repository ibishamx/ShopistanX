# --- Database -------------------------------------------------------------
# Owner connection: used only for migrations and role setup.
DATABASE_URL=postgresql://shopistan:shopistan@localhost:5432/shopistan
# Tenant-scoped role. Cannot bypass row-level security.
APP_DATABASE_URL=postgresql://shopistan_app:app_password@localhost:5432/shopistan
# Super Admin role. Bypasses row-level security; used only by /platform routes.
PLATFORM_DATABASE_URL=postgresql://shopistan_platform:platform_password@localhost:5432/shopistan

# --- Secrets --------------------------------------------------------------
# 32 random bytes, hex. Encrypts WhatsApp/courier/gateway credentials at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- URLs -----------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
MERCHANT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3003
# Stores are served at <slug>.<STOREFRONT_ROOT_DOMAIN>. STOREFRONT_PORT is only
# appended to generated links in local development.
STOREFRONT_ROOT_DOMAIN=localhost
STOREFRONT_PROTOCOL=http
STOREFRONT_PORT=3002
COOKIE_SECURE=false

# --- WhatsApp Cloud API ---------------------------------------------------
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0

# --- First Super Admin (used by pnpm db:seed) -----------------------------
PLATFORM_ADMIN_EMAIL=admin@shopistan.pk
PLATFORM_ADMIN_PASSWORD=
